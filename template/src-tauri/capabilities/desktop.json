{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Main window: plugins that exist only on desktop",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    {%- if tauri_global_shortcut %}
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",{% endif %}{% if tauri_autostart %}
    "autostart:default",{% endif %}{% if tauri_window_state %}
    "window-state:default",{% endif %}{% if tauri_process %}
    "process:default",{% endif %}{% if tauri_positioner %}
    "positioner:default",{% endif %}{% if tauri_shell %}
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "git-version", "cmd": "git", "args": ["--version"], "sidecar": false }]
    },{% endif %}
    "core:default"
  ]
}
