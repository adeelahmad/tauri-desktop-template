{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{app_name}}",
  "version": "0.1.0",
  "identifier": "{{identifier}}",
  "build": {
    {%- if frontend == "react" %}
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui-react install --include=dev && npm --prefix ui-react run dev",
    "beforeBuildCommand": "npm --prefix ui-react ci --include=dev && npm --prefix ui-react run build",
    "frontendDist": "../ui-react/dist"
    {%- else %}
    "frontendDist": "../ui"{% endif %}
  },
  "app": {
    "withGlobalTauri": {% if frontend == "react" %}false{% else %}true{% endif %},
    "windows": [
      {
        "title": "{{app_name}}",
        "width": 960,
        "height": 760{% if app_shell %},
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false{% endif %}
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",{% if updater %}
    "createUpdaterArtifacts": true,{% endif %}
    "shortDescription": "{{description}}",{% if python_example %}
    "resources": {
      "../python/worker.py": "python/worker.py"
    },{% endif %}
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4",{% if stt %}
      "entitlements": "Entitlements.plist",{% endif %}
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }{% if updater or tauri_plugins and tauri_deep_link %},
  "plugins": {
    {%- if updater %}
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/{{github_repo}}/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }{% if tauri_plugins and tauri_deep_link %},{% endif %}{% endif %}{% if tauri_plugins and tauri_deep_link %}
    "deep-link": {
      "desktop": {
        "schemes": ["{{project-name}}"]
      }
    }{% endif %}
  }{% endif %}
}
