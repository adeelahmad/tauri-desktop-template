{
  "targets": [
    { "os": "macos-latest", "target": "aarch64-apple-darwin", "bundles": "app,dmg", "name": "macOS-AppleSilicon", "updater": "darwin-aarch64" },
    { "os": "windows-latest", "target": "x86_64-pc-windows-msvc", "bundles": "nsis", "name": "Windows", "updater": "windows-x86_64" }{% if linux %},
    { "os": "ubuntu-22.04", "target": "x86_64-unknown-linux-gnu", "bundles": "appimage,deb", "name": "Linux", "updater": "linux-x86_64" }{% endif %}
  ],
  "macos_pkg": {% if macos_pkg %}true{% else %}false{% endif %},
  "uv_sidecar": {% if claude_mcp %}true{% else %}false{% endif %},
  "uv_version": "0.11.32"
}
