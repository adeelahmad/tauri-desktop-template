# Postgres extensions bundled with the embedded server. Bump here, then run the
# "Postgres extensions" workflow with publish=true to cut a new pg-ext release.
PG_VERSION=16.16.0
PGRX_VERSION=0.16.1
PGVECTOR_VERSION=0.8.1
PG_TOKENIZER_VERSION=0.1.1
VCHORD_BM25_VERSION=0.3.0
# Bump when the bundle changes without a version change; the app pins this tag.
PG_EXT_REVISION=1
